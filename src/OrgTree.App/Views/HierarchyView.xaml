<UserControl x:Class="OrgTree.App.Views.HierarchyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OrgTree.App.ViewModels"
             xmlns:views="clr-namespace:OrgTree.App.Views">

    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:DepartmentHierarchyNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                <Border Width="14" Height="14"
                        Margin="0,0,6,0"
                        Background="{Binding BoxColor}"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Visibility="{Binding IsDepartment, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding Name}" FontSize="18"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:EmployeeHierarchyNode}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="&#xE77B;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBlock x:Name="EmployeeName" Text="{Binding Name}" FontSize="15"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLeader}" Value="True">
                    <Setter TargetName="EmployeeName" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EmployeeEditViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontSize="28" FontWeight="Bold"/>
                <views:EmployeeForm/>
                <Button Content="Speichern"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource DialogButton}"
                        HorizontalAlignment="Right"
                        Margin="0,28,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DepartmentEditViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontSize="28" FontWeight="Bold"/>
                <views:DepartmentForm/>
                <Button Content="Speichern"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource DialogButton}"
                        HorizontalAlignment="Right"
                        Margin="0,28,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TreeView Grid.Column="0"
                  ItemsSource="{Binding Roots}"
                  Background="#EEF5E9"
                  BorderThickness="0"
                  Padding="24"
                  SelectedItemChanged="OnSelectedItemChanged">
            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#9DB594"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#9DB594"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                </Style>
            </TreeView.Resources>
        </TreeView>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28">
                <TextBlock Text="Wähle links eine Abteilung oder MitarbeiterIn aus."
                           Foreground="#A6A6A6"
                           FontSize="18"
                           Visibility="{Binding HasNoDetail, Converter={StaticResource BoolToVisibility}}"/>
                <ContentControl Content="{Binding Detail}"
                                MaxWidth="520"
                                HorizontalAlignment="Left"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
