<UserControl x:Class="OrgTree.App.Views.OrgChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OrgTree.App.ViewModels">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ConnectorBrush" Color="Black"/>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <DataTemplate DataType="{x:Type vm:OrgChartNode}">
            <StackPanel>
                <Grid Height="34"
                      Visibility="{Binding HasParent, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0"
                               Height="3"
                               VerticalAlignment="Top"
                               Fill="{StaticResource ConnectorBrush}"
                               Visibility="{Binding ShowLeftLine, Converter={StaticResource BoolToVisibility}}"/>
                    <Rectangle Grid.Column="1"
                               Height="3"
                               VerticalAlignment="Top"
                               Fill="{StaticResource ConnectorBrush}"
                               Visibility="{Binding ShowRightLine, Converter={StaticResource BoolToVisibility}}"/>
                    <Rectangle Grid.ColumnSpan="2"
                               Width="3"
                               HorizontalAlignment="Center"
                               Fill="{StaticResource ConnectorBrush}"/>
                    <Path Grid.ColumnSpan="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Data="M0,0 L7,8 L14,0"
                          Stroke="{StaticResource ConnectorBrush}"
                          StrokeThickness="3"/>
                </Grid>

                <Border Background="{Binding BoxColor}"
                        MinWidth="200"
                        Padding="16,12"
                        Margin="20,0"
                        HorizontalAlignment="Center">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LeaderName, TargetNullValue=-}"
                                       FontSize="18"
                                       Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <ToggleButton Width="16"
                                      Height="16"
                                      Padding="0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      ToolTip="Abteilungsleitung ein- oder ausblenden"
                                      AutomationProperties.Name="Abteilungsleitung ein- oder ausblenden"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Content" Value="&#xE70D;"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Content" Value="&#xE76B;"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                </Border>

                <Rectangle Width="3"
                           Height="20"
                           HorizontalAlignment="Center"
                           Fill="{StaticResource ConnectorBrush}"
                           Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding Children}"
                              ItemsPanel="{StaticResource HorizontalPanel}"
                              HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Roots}"
                          ItemsPanel="{StaticResource HorizontalPanel}"
                          HorizontalAlignment="Center"
                          Margin="50"/>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Keine Abteilungsstruktur gefunden."
                       Style="{StaticResource EmptyStateTitle}"/>
            <TextBlock Text="Das Organigramm erscheint, sobald eine Abteilung eine Unterabteilung hat."
                       Style="{StaticResource EmptyStateText}"/>
        </StackPanel>
    </Grid>
</UserControl>
