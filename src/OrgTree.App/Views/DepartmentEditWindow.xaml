<Window x:Class="OrgTree.App.Views.DepartmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F9ECEC">

    <StackPanel Margin="28">
        <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="Bold"/>

        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Farbe" Style="{StaticResource FieldLabel}"/>
        <DockPanel>
            <Border DockPanel.Dock="Right"
                    Width="32"
                    Margin="8,0,0,0"
                    Background="{Binding ColorPreview}"
                    BorderBrush="Black"
                    BorderThickness="1"/>
            <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <TextBlock Text="{Binding ColorError}"
                   Foreground="#C0392B"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ColorError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="AbteilungsleiterIn" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Leaders}"
                  SelectedItem="{Binding SelectedLeader}"
                  DisplayMemberPath="Name"/>

        <TextBlock Text="Übergeordnete Abteilung" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding ParentDepartments}"
                  SelectedItem="{Binding SelectedParentDepartment}"
                  DisplayMemberPath="Name"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource DialogButton}"/>
            <Button Content="Speichern" IsDefault="True" Command="{Binding SaveCommand}" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
